---
import BaseLayout from '~/layouts/BaseLayout.astro'
import NewsletterForm from '~/components/react/NewsletterForm.jsx'
import { site } from '~/lib/site'
---

<BaseLayout title="Contact" description="Reach Fit Girl Things — for readers, event RSVPs, sponsor asks, press, and partnerships.">
  <section class="contact-page section">
    <div class="container contact-grid">
      <div class="reveal">
        <span class="eyebrow">Contact & Support</span>
        <h1>Get in touch.</h1>
        <p class="lead">
          Questions, feedback, or partnership inquiries — we'd love to hear from you. We reply within
          2 business days.
        </p>

        <div class="contact-boxes">
          <div class="contact-box">
            <h3>Email</h3>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div class="contact-box">
            <h3>Social</h3>
            <a href={site.instagram} target="_blank" rel="noreferrer">{site.handle} on Instagram</a>
          </div>
          <div class="contact-box">
            <h3>Partnerships & Sponsors</h3>
            <p>Send with "PARTNERSHIP" in the subject line for fastest routing. Or <a href="/for/sponsor">see the sponsor deck</a>.</p>
          </div>
          <div class="contact-box">
            <h3>Event Inquiries</h3>
            <p>Send with "EVENT INQUIRY" in the subject line — includes speaker asks, hosting your event with us, or venue introductions.</p>
          </div>
          <div class="contact-box">
            <h3>Press & Media</h3>
            <p>Send with "PRESS" in the subject line. We keep a rolling list of stories.</p>
          </div>
          <div class="contact-box">
            <h3>Technical Issues</h3>
            <p>Please include the page URL and your browser/device when reaching out.</p>
          </div>
        </div>
      </div>

      <aside class="side reveal">
        <div class="side-card">
          <h3>Response time</h3>
          <p>Within 2 business days. During event weeks, it may be a little longer — thanks for the patience.</p>
        </div>
        <div class="side-card newsletter-card">
          <span class="mini-kicker">Meanwhile</span>
          <h3>Join the newsletter.</h3>
          <p>Weekly wellness edits, event drops, and product finds — no spam, ever.</p>
          <NewsletterForm client:load compact source="contact-page" />
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .contact-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 2.5rem; align-items: start; }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0.5rem 0 1rem;
    font-weight: 600;
  }
  .lead { color: var(--muted); line-height: var(--leading-relaxed); font-size: 1.1rem; max-width: 52ch; }
  .contact-boxes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }
  .contact-box {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
  }
  .contact-box h3 {
    margin: 0 0 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .contact-box a { color: var(--accent-deep); font-weight: 700; }
  .contact-box p { color: var(--muted); line-height: var(--leading-relaxed); margin: 0.25rem 0 0; font-size: 0.95rem; }

  .side { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: calc(var(--nav-height) + 1rem); }
  .side-card {
    padding: 1.5rem;
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--surface) 90%, transparent);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
  }
  .newsletter-card { background: var(--surface-blush); }
  .side-card h3 {
    margin: 0.4rem 0 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    letter-spacing: -0.01em;
  }
  .side-card p { color: var(--muted); line-height: var(--leading-relaxed); margin: 0 0 0.8rem; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
    .side { position: static; }
  }
</style>
