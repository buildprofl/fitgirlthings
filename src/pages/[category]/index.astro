---
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import { categories } from '~/lib/site'

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { categoryMeta: cat },
  }))
}

const { categoryMeta } = Astro.props
const all = await getCollection('articles', ({ data }) => !data.draft && data.category === categoryMeta.label)
const sorted = all.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
)
const lead = sorted[0]
const rest = sorted.slice(1)
---

<BaseLayout
  title={categoryMeta.label}
  description={`${categoryMeta.description} Read the latest ${categoryMeta.label} stories from Fit Girl Things.`}
>
  <section class="category-page section">
    <div class="container">
      <header class="page-header reveal">
        <span class="eyebrow">{categoryMeta.label}</span>
        <h1>{categoryMeta.label}</h1>
        <p>{categoryMeta.description}</p>
      </header>

      {lead && (
        <a href={`/${categoryMeta.slug}/${lead.slug}`} class="lead-story reveal">
          <div class="lead-image reveal-image">
            <img
              src={lead.data.image}
              alt={lead.data.imageAlt ?? lead.data.title}
              loading="eager"
              decoding="async"
              width="900"
              height="600"
            />
          </div>
          <div class="lead-copy">
            <span class="mini-kicker">{lead.data.kicker ?? categoryMeta.label}</span>
            <h2>{lead.data.title}</h2>
            <p>{lead.data.excerpt}</p>
            <span class="text-link">Read the story</span>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="article-grid">
          {rest.map((item, i) => (
            <a
              href={`/${categoryMeta.slug}/${item.slug}`}
              class="article-card reveal"
              style={`transition-delay: ${Math.min(i, 8) * 60}ms`}
            >
              <div class="card-image reveal-image">
                <img
                  src={item.data.image}
                  alt={item.data.imageAlt ?? item.data.title}
                  loading="lazy"
                  decoding="async"
                  width="700"
                  height="500"
                />
              </div>
              <div class="card-copy">
                <span class="mini-kicker">{item.data.kicker ?? categoryMeta.label}</span>
                <h3>{item.data.title}</h3>
                <p>{item.data.excerpt}</p>
                <time datetime={item.data.publishedAt.toISOString()}>
                  {item.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
            </a>
          ))}
        </div>
      )}

      {!lead && (
        <div class="empty-state">
          <p>New {categoryMeta.label} stories are on the way — check back soon.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { max-width: 780px; margin: 0 auto 2.5rem; text-align: center; }
  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5.5vw, 4.6rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0.5rem 0 1rem;
    font-weight: 600;
  }
  .page-header > p { color: var(--muted); line-height: var(--leading-relaxed); font-size: 1.1rem; margin: 0; }

  .lead-story {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 1.25rem;
    padding: 1rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--surface), var(--surface-soft));
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
    color: inherit;
    transition: transform var(--dur-med), box-shadow var(--dur-med);
    margin-bottom: 2rem;
  }
  .lead-story:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .lead-image { overflow: hidden; border-radius: calc(var(--radius-xl) - 8px); }
  .lead-image img { width: 100%; height: 100%; min-height: 340px; object-fit: cover; display: block; transition: transform 600ms var(--ease-out); }
  .lead-story:hover .lead-image img { transform: scale(1.03); }
  .lead-copy { padding: 1rem 0.35rem; display: flex; flex-direction: column; justify-content: center; }
  .lead-copy h2 {
    margin: 0.7rem 0 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .lead-copy p { color: var(--muted); line-height: var(--leading-relaxed); margin: 0; }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }
  .article-card {
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform var(--dur-med), box-shadow var(--dur-med);
  }
  .article-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .card-image { overflow: hidden; }
  .card-image img { width: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform 500ms var(--ease-out); }
  .article-card:hover .card-image img { transform: scale(1.05); }
  .card-copy { padding: 1.15rem 1.15rem 1.35rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .card-copy h3 {
    margin: 0.5rem 0 0.35rem;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .card-copy p { margin: 0 0 auto; color: var(--muted); line-height: var(--leading-relaxed); font-size: 0.93rem; }
  .card-copy time { color: var(--muted); font-size: 0.8rem; margin-top: 0.9rem; padding-top: 0.75rem; border-top: 1px solid var(--line); }

  .empty-state { text-align: center; padding: 3rem 1rem; color: var(--muted); }

  @media (max-width: 1080px) {
    .lead-story { grid-template-columns: 1fr; }
    .lead-image img { min-height: 260px; }
    .article-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .article-grid { grid-template-columns: 1fr; }
  }
</style>
