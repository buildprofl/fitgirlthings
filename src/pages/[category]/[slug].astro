---
import { getCollection } from 'astro:content'
import ArticleLayout from '~/layouts/ArticleLayout.astro'
import { categorySlug, categories } from '~/lib/site'

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft)
  return articles
    .filter((entry) => categories.some((c) => c.label === entry.data.category))
    .map((entry) => ({
      params: { category: categorySlug(entry.data.category), slug: entry.slug },
      props: { entry },
    }))
}

const { entry } = Astro.props
const { Content } = await entry.render()
---

<ArticleLayout
  title={entry.data.title}
  excerpt={entry.data.excerpt}
  category={entry.data.category}
  categorySlug={categorySlug(entry.data.category)}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  author={entry.data.author}
  readingMinutes={entry.data.readingMinutes}
  slug={entry.slug}
  tags={entry.data.tags}
>
  <Content />
</ArticleLayout>
