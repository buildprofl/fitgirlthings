---
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const all = await getCollection('events', ({ data }) => !data.draft)
const now = Date.now()
const upcoming = all
  .filter((e) => new Date(e.data.date).getTime() >= now - 24 * 60 * 60 * 1000)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
const past = all
  .filter((e) => new Date(e.data.date).getTime() < now - 24 * 60 * 60 * 1000)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
---

<BaseLayout
  title="Events"
  description="Fit Girl Things events — walk clubs, recovery mornings, rooftop socials, and more. Miami first, expanding."
>
  <section class="events-page section">
    <div class="container">
      <header class="page-header reveal">
        <span class="eyebrow">Events</span>
        <h1>The rooms worth being in.</h1>
        <p>
          Walk clubs, recovery mornings, rooftop socials, and everything in between. Newsletter
          subscribers get first access to every event drop.
        </p>
      </header>

      {upcoming.length > 0 && (
        <section class="events-block">
          <h2>Upcoming</h2>
          <div class="events-list">
            {upcoming.map((event, i) => (
              <a href={`/events/${event.slug}`} class="event-row reveal" style={`transition-delay: ${i * 60}ms`}>
                <div class="event-date">
                  <span class="event-month">{event.data.dateLabelMonth}</span>
                  <span class="event-day">{event.data.dateLabelDay}</span>
                </div>
                <div class="event-body">
                  <h3>{event.data.title}</h3>
                  <p class="event-meta">
                    <span>{event.data.place}</span>
                    {event.data.price && <><span aria-hidden="true">·</span><span>{event.data.price}</span></>}
                  </p>
                  <p class="event-summary">{event.data.summary}</p>
                  <span class="text-link">View details & RSVP</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {past.length > 0 && (
        <section class="events-block past">
          <h2>Past events</h2>
          <div class="past-grid">
            {past.map((event) => (
              <a href={`/events/${event.slug}`} class="past-card reveal">
                <span class="past-date">{event.data.dateLabelMonth} {event.data.dateLabelDay}</span>
                <span class="past-title">{event.data.title}</span>
                <span class="past-place">{event.data.place}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { max-width: 780px; margin: 0 auto 3rem; text-align: center; }
  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5.5vw, 4.6rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0.5rem 0 1rem;
    font-weight: 600;
  }
  .page-header > p { color: var(--muted); line-height: var(--leading-relaxed); font-size: 1.1rem; margin: 0; }

  .events-block { margin-bottom: 3rem; }
  .events-block h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
    font-weight: 600;
  }

  .events-list { display: flex; flex-direction: column; gap: 1rem; }

  .event-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    background: color-mix(in oklab, var(--surface) 90%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    color: inherit;
    transition: transform var(--dur-med), box-shadow var(--dur-med), border-color var(--dur-med);
  }
  .event-row:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--accent-strong); }

  .event-date {
    width: 100px;
    padding: 0.9rem 0.6rem;
    border-radius: 16px;
    background: linear-gradient(135deg, #ffd7de, #ffedf0);
    color: #6e3148;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1;
    gap: 0.2rem;
  }
  .event-month { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 800; }
  .event-day { font-family: var(--font-serif); font-size: 2.4rem; font-weight: 700; letter-spacing: -0.02em; }

  .event-body { min-width: 0; }
  .event-body h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .event-meta {
    display: flex;
    gap: 0.6rem;
    color: var(--muted);
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    flex-wrap: wrap;
  }
  .event-summary { color: var(--muted); line-height: var(--leading-relaxed); margin: 0 0 0.5rem; }

  .past { opacity: 0.85; }
  .past-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.8rem;
  }
  .past-card {
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: color-mix(in oklab, var(--surface) 60%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: inherit;
    transition: background var(--dur-fast);
  }
  .past-card:hover { background: var(--surface); }
  .past-date { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 800; color: var(--accent-deep); }
  .past-title { font-family: var(--font-serif); font-size: 1.05rem; letter-spacing: -0.01em; font-weight: 600; }
  .past-place { color: var(--muted); font-size: 0.85rem; }

  @media (max-width: 640px) {
    .event-row { grid-template-columns: 1fr; gap: 1rem; }
    .event-date { width: fit-content; flex-direction: row; padding: 0.5rem 0.9rem; gap: 0.5rem; }
    .event-day { font-size: 1.5rem; }
  }
</style>
