---
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import RSVPForm from '~/components/react/RSVPForm.jsx'
import { site } from '~/lib/site'

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft)
  return events.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await entry.render()

const canonicalUrl = new URL(`/events/${entry.slug}`, site.url).href
const startIso = entry.data.date.toISOString()
const dateLabel = entry.data.date.toLocaleDateString('en-US', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
})

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: entry.data.title,
  description: entry.data.summary,
  startDate: startIso,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: entry.data.place, address: entry.data.place },
  image: entry.data.image ? [new URL(entry.data.image, site.url).href] : undefined,
  organizer: { '@type': 'Organization', name: entry.data.hostedBy, url: site.url },
  offers: entry.data.price ? {
    '@type': 'Offer',
    url: canonicalUrl,
    price: entry.data.price,
    availability: 'https://schema.org/InStock',
  } : undefined,
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  image={entry.data.image ?? '/og/default.png'}
  type="website"
  jsonLd={eventJsonLd}
>
  <article class="event-page">
    <header class="event-hero">
      <div class="container event-hero-inner">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/events">Events</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{entry.data.title}</span>
        </nav>
        <span class="mini-kicker">Event</span>
        <h1>{entry.data.title}</h1>
        <p class="event-lead">{entry.data.summary}</p>
        <div class="event-meta">
          <div class="meta-item">
            <span class="meta-label">Date</span>
            <span>{dateLabel}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Where</span>
            <span>{entry.data.place}</span>
          </div>
          {entry.data.price && (
            <div class="meta-item">
              <span class="meta-label">Price</span>
              <span>{entry.data.price}</span>
            </div>
          )}
          {entry.data.capacity && (
            <div class="meta-item">
              <span class="meta-label">Capacity</span>
              <span>{entry.data.capacity} guests</span>
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="container event-grid">
      <div class="event-body">
        {entry.data.image && (
          <div class="event-image reveal-image">
            <img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} loading="lazy" width="1200" height="750" />
          </div>
        )}

        <div class="prose">
          <Content />
        </div>

        {entry.data.highlights.length > 0 && (
          <section class="highlights reveal">
            <h2>What to expect</h2>
            <ul>
              {entry.data.highlights.map((h) => (
                <li><span class="check" aria-hidden="true">✓</span>{h}</li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="rsvp-panel reveal">
        <div class="rsvp-card">
          <span class="mini-kicker">Reserve your spot</span>
          <h2>RSVP</h2>
          <p>You'll get a confirmation email with all the details and reminders as we get closer.</p>
          <RSVPForm client:load event={entry.data.title} />
        </div>
        <a href="/events" class="text-link">See all events</a>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .event-hero { padding-top: clamp(1.5rem, 4vw, 3rem); padding-bottom: 2rem; }
  .event-hero-inner { max-width: 900px; margin: 0 auto; text-align: center; }

  .crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .crumb a { color: var(--accent-deep); font-weight: 600; }

  .event-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0.6rem 0 1rem;
    font-weight: 600;
  }

  .event-lead { color: var(--muted); font-size: 1.15rem; line-height: var(--leading-relaxed); max-width: 60ch; margin: 0 auto 2rem; }

  .event-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--surface) 60%, transparent);
    border: 1px solid var(--line);
  }
  .meta-item { display: flex; flex-direction: column; gap: 0.15rem; text-align: left; }
  .meta-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-deep);
    font-weight: 800;
  }
  .meta-item > span:not(.meta-label) { color: var(--text); font-weight: 600; }

  .event-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2.5rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
    align-items: start;
  }

  .event-image {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
    aspect-ratio: 16 / 10;
  }
  .event-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .prose {
    font-size: 1.05rem;
    line-height: var(--leading-relaxed);
    color: var(--text);
  }
  .prose :global(p) { margin: 0 0 1.15rem; }
  .prose :global(strong) { color: var(--text); font-weight: 700; }

  .highlights { margin-top: 2rem; }
  .highlights h2 { font-family: var(--font-serif); font-size: 1.5rem; letter-spacing: -0.01em; margin: 0 0 1rem; font-weight: 600; }
  .highlights ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .highlights li { display: flex; gap: 0.7rem; align-items: flex-start; color: var(--text); line-height: var(--leading-relaxed); }
  .check {
    display: inline-grid; place-items: center;
    width: 22px; height: 22px; border-radius: 999px;
    background: var(--accent-strong); color: #fff;
    font-size: 0.72rem; font-weight: 800; flex-shrink: 0; margin-top: 3px;
  }

  .rsvp-panel { position: sticky; top: calc(var(--nav-height) + 1rem); display: flex; flex-direction: column; gap: 1rem; }
  .rsvp-card {
    padding: 1.75rem;
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--surface) 92%, transparent);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .rsvp-card h2 {
    margin: 0.4rem 0 0.5rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    letter-spacing: -0.02em;
  }
  .rsvp-card > p { color: var(--muted); line-height: var(--leading-relaxed); margin: 0 0 1.25rem; }

  @media (max-width: 900px) {
    .event-grid { grid-template-columns: 1fr; }
    .rsvp-panel { position: static; }
  }
</style>
