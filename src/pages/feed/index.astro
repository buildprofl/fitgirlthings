---
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const all = await getCollection('articles', ({ data }) => !data.draft)
const sorted = all.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
)

const categories = ['All', ...Array.from(new Set(sorted.map((a) => a.data.category)))]
---

<BaseLayout
  title="The Feed"
  description="Editorial stories on wellness culture, fitness, beauty, events, and the fit-girl world."
>
  <section class="feed-page section">
    <div class="container">
      <header class="page-header reveal">
        <span class="eyebrow">The Feed</span>
        <h1>Stories worth your time.</h1>
        <p>
          Culture, wellness, fitness, beauty, and events — curated by editors, not algorithms.
        </p>

        <div class="feed-tools">
          <label class="search" for="feed-search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            <input id="feed-search" type="search" placeholder="Search articles…" data-feed-search />
          </label>
          <div class="chips" role="tablist" aria-label="Filter by category">
            {categories.map((cat) => (
              <button
                type="button"
                class:list={['chip', { active: cat === 'All' }]}
                data-category={cat}
                role="tab"
                aria-selected={cat === 'All'}
              >{cat}</button>
            ))}
          </div>
        </div>
      </header>

      <div class="feed-grid" data-feed-grid>
        {sorted.map((item, i) => (
          <a
            href={`/feed/${item.slug}`}
            class="feed-card reveal"
            style={`transition-delay: ${Math.min(i, 8) * 60}ms`}
            data-category={item.data.category}
            data-title={item.data.title.toLowerCase()}
            data-excerpt={item.data.excerpt.toLowerCase()}
          >
            <div class="feed-image reveal-image">
              <img
                src={item.data.image}
                srcset={`${item.data.imageMobile ?? item.data.image} 320w, ${item.data.image} 700w`}
                sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 33vw"
                alt={item.data.imageAlt ?? item.data.title}
                loading="lazy"
                decoding="async"
                width="700"
                height="630"
              />
            </div>
            <div class="feed-copy">
              <span class="mini-kicker">{item.data.category}</span>
              <h2>{item.data.title}</h2>
              <p>{item.data.excerpt}</p>
              <div class="feed-meta">
                <time datetime={item.data.publishedAt.toISOString()}>
                  {item.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                {item.data.readingMinutes && <span>· {item.data.readingMinutes} min</span>}
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="empty-state" data-feed-empty hidden>
        <p>No stories match that filter. Try clearing the search.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { max-width: 820px; margin: 0 auto 2.5rem; text-align: center; }
  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5.5vw, 4.6rem);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0.5rem 0 1rem;
    font-weight: 600;
  }
  .page-header > p {
    color: var(--muted);
    line-height: var(--leading-relaxed);
    font-size: 1.1rem;
    margin: 0;
  }

  .feed-tools {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .search {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    width: min(420px, 100%);
    color: var(--muted);
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .search:focus-within { border-color: var(--accent-strong); box-shadow: 0 0 0 4px var(--accent-glow); }
  .search input {
    flex: 1;
    border: 0;
    background: transparent;
    outline: none;
    font-size: 0.95rem;
    color: var(--text);
  }

  .chips { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; }
  .chip {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
  }
  .chip:hover { border-color: var(--accent-strong); }
  .chip.active { background: var(--accent-strong); color: #fff; border-color: var(--accent-strong); }

  .feed-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
    margin-top: 1rem;
  }

  .feed-card {
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform var(--dur-med), box-shadow var(--dur-med);
  }
  .feed-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .feed-card[hidden] { display: none; }
  .feed-image { overflow: hidden; }
  .feed-image img { width: 100%; aspect-ratio: 1/0.9; object-fit: cover; transition: transform 500ms var(--ease-out); }
  .feed-card:hover .feed-image img { transform: scale(1.05); }
  .feed-copy { padding: 1.15rem 1.15rem 1.35rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .feed-copy h2 {
    margin: 0.5rem 0 0.35rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .feed-copy p { margin: 0 0 auto; color: var(--muted); line-height: var(--leading-relaxed); font-size: 0.95rem; }
  .feed-meta {
    display: flex;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.8rem;
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--muted);
  }

  @media (max-width: 1080px) { .feed-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .feed-grid { grid-template-columns: 1fr; } }
</style>

<script>
  // Client-side filter: category chips + search input
  const grid = document.querySelector<HTMLElement>('[data-feed-grid]')
  const emptyEl = document.querySelector<HTMLElement>('[data-feed-empty]')
  const search = document.querySelector<HTMLInputElement>('[data-feed-search]')
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip')
  let activeCategory = 'All'

  function apply() {
    if (!grid) return
    const q = (search?.value ?? '').trim().toLowerCase()
    const cards = grid.querySelectorAll<HTMLElement>('.feed-card')
    let visibleCount = 0
    cards.forEach((card) => {
      const cat = card.dataset.category ?? ''
      const title = card.dataset.title ?? ''
      const excerpt = card.dataset.excerpt ?? ''
      const matchesCat = activeCategory === 'All' || cat === activeCategory
      const matchesQ = !q || title.includes(q) || excerpt.includes(q)
      const show = matchesCat && matchesQ
      card.hidden = !show
      if (show) visibleCount++
    })
    if (emptyEl) emptyEl.hidden = visibleCount > 0
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => {
        c.classList.remove('active')
        c.setAttribute('aria-selected', 'false')
      })
      chip.classList.add('active')
      chip.setAttribute('aria-selected', 'true')
      activeCategory = chip.dataset.category ?? 'All'
      apply()
    })
  })

  search?.addEventListener('input', apply)
</script>
