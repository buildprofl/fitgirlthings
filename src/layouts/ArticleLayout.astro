---
import BaseLayout from './BaseLayout.astro'
import { site } from '~/lib/site'

interface Props {
  title: string
  excerpt: string
  category: string
  image: string
  imageAlt?: string
  publishedAt: Date
  updatedAt?: Date
  author: string
  readingMinutes?: number
  slug: string
  tags?: string[]
}

const { title, excerpt, category, image, imageAlt, publishedAt, updatedAt, author, readingMinutes, slug, tags = [] } = Astro.props

const canonicalUrl = new URL(`/feed/${slug}`, site.url).href
const publishedIso = publishedAt.toISOString()
const updatedIso = (updatedAt ?? publishedAt).toISOString()
const publishedLabel = publishedAt.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
})

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  image: [new URL(image, site.url).href],
  datePublished: publishedIso,
  dateModified: updatedIso,
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: `${site.url}/og/default.png` },
  },
  mainEntityOfPage: canonicalUrl,
  articleSection: category,
  keywords: tags.join(', '),
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'The Feed', item: `${site.url}/feed` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
}

const shareUrl = encodeURIComponent(canonicalUrl)
const shareText = encodeURIComponent(`${title} — ${site.name}`)
---

<BaseLayout
  title={title}
  description={excerpt}
  image={image}
  type="article"
  publishedTime={publishedIso}
  modifiedTime={updatedIso}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <article class="article">
    <header class="article-hero">
      <div class="container article-hero-inner">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/feed">The Feed</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{title}</span>
        </nav>
        <span class="mini-kicker">{category}</span>
        <h1>{title}</h1>
        <p class="excerpt">{excerpt}</p>
        <div class="meta">
          <span><strong>{author}</strong></span>
          <span aria-hidden="true">·</span>
          <time datetime={publishedIso}>{publishedLabel}</time>
          {readingMinutes && (
            <>
              <span aria-hidden="true">·</span>
              <span>{readingMinutes} min read</span>
            </>
          )}
        </div>
      </div>
      <div class="container">
        <div class="article-image reveal-image">
          <img src={image} alt={imageAlt ?? title} width="1400" height="900" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </header>

    <div class="container article-body-wrap">
      <div class="article-body">
        <slot />
      </div>

      <aside class="article-share">
        <span class="share-label">Share</span>
        <a
          class="share-btn"
          href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
          target="_blank" rel="noreferrer"
          aria-label="Share on Twitter"
        >X</a>
        <a
          class="share-btn"
          href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
          target="_blank" rel="noreferrer"
          aria-label="Share on Facebook"
        >f</a>
        <a
          class="share-btn"
          href={`mailto:?subject=${shareText}&body=${shareUrl}`}
          aria-label="Share via email"
        >@</a>
        <a
          class="share-btn"
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
          target="_blank" rel="noreferrer"
          aria-label="Share on LinkedIn"
        >in</a>
      </aside>
    </div>

    <section class="article-cta section blush">
      <div class="container article-cta-inner">
        <span class="eyebrow">Enjoyed this?</span>
        <h2>Get the next one in your inbox.</h2>
        <p>Weekly editorial drops — wellness culture, event invitations, product finds. No spam.</p>
        <a href="/#newsletter" class="button primary">Join the newsletter</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-hero {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 2rem;
  }

  .article-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .crumb a { color: var(--accent-deep); font-weight: 600; }
  .crumb a:hover { color: var(--accent-strong); }

  .article-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0.6rem 0 1rem;
    font-weight: 600;
  }

  .excerpt {
    color: var(--muted);
    font-size: 1.2rem;
    line-height: var(--leading-relaxed);
    max-width: 58ch;
    margin: 0 auto 1.5rem;
  }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.9rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .meta strong { color: var(--text); }

  .article-image {
    max-width: 1080px;
    margin: 2rem auto 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 10;
  }
  .article-image img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .article-body-wrap {
    display: grid;
    grid-template-columns: 1fr 60px;
    gap: 2rem;
    align-items: start;
    max-width: 900px;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .article-body {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text);
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 3rem 0 1rem;
    font-weight: 600;
  }

  .article-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.85rem;
    font-weight: 600;
  }

  .article-body :global(p) {
    margin: 0 0 1.35rem;
    color: var(--text);
  }

  .article-body :global(strong) { color: var(--text); font-weight: 700; }
  .article-body :global(em) { color: var(--muted); font-style: italic; }

  .article-body :global(a) {
    color: var(--accent-deep);
    font-weight: 600;
    border-bottom: 1px solid color-mix(in oklab, var(--accent-deep) 40%, transparent);
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .article-body :global(a:hover) { color: var(--accent-strong); border-color: var(--accent-strong); }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.5rem 1.5rem;
    padding: 0;
  }

  .article-body :global(li) { margin-bottom: 0.7rem; color: var(--text); }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--accent-strong);
    padding: 0.5rem 0 0.5rem 1.5rem;
    margin: 1.75rem 0;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .article-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2.5rem auto;
    width: 80px;
  }

  .article-body :global(code) {
    background: var(--surface-soft);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.92em;
  }

  .article-share {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .share-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .share-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    color: var(--text);
    font-weight: 700;
    font-size: 0.95rem;
    transition: background var(--dur-fast), transform var(--dur-fast), color var(--dur-fast);
  }
  .share-btn:hover { background: var(--accent-strong); color: #fff; transform: translateY(-2px); }

  .article-cta { margin-top: 3rem; }
  .article-cta-inner { text-align: center; max-width: 540px; margin: 0 auto; }
  .article-cta-inner h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    letter-spacing: -0.02em;
    margin: 0.6rem 0 0.75rem;
    line-height: 1.1;
  }
  .article-cta-inner p { color: var(--muted); line-height: var(--leading-relaxed); margin: 0 0 1.5rem; }

  @media (max-width: 900px) {
    .article-body-wrap { grid-template-columns: 1fr; }
    .article-share {
      position: static;
      flex-direction: row;
      justify-content: center;
      margin-top: 2rem;
    }
    .share-label { display: none; }
  }
</style>
