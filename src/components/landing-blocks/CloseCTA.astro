---
interface Props {
  eyebrow?: string
  title: string
  subtitle?: string
  cta: { label: string; href: string }
  reassurance?: string
}
const { eyebrow, title, subtitle, cta, reassurance } = Astro.props
---

<section class="lb-close section blush">
  <div class="container">
    <div class="lb-close-inner reveal">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
      {subtitle && <p>{subtitle}</p>}
      <a href={cta.href} class="button primary">{cta.label}</a>
      {reassurance && <small>{reassurance}</small>}
    </div>
  </div>
</section>

<style>
  .lb-close-inner {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .lb-close-inner h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: -0.02em;
    margin: 0.5rem 0 1rem;
    line-height: 1.05;
  }
  .lb-close-inner p {
    color: var(--muted);
    line-height: var(--leading-relaxed);
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
  }
  .lb-close-inner .button { padding: 1.05rem 2rem; font-size: 1.02rem; }
  .lb-close-inner small { display: block; margin-top: 1rem; color: var(--muted); font-size: 0.85rem; }
</style>
