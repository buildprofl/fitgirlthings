---
interface Props {
  eyebrow?: string
  title?: string
  provider: 'youtube' | 'vimeo'
  videoId: string
}
const { eyebrow, title, provider, videoId } = Astro.props
const src =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`
    : `https://player.vimeo.com/video/${videoId}`
---

<section class="lb-video section">
  <div class="container">
    <div class="section-header center reveal">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      {title && <h2>{title}</h2>}
    </div>
    <div class="lb-video-frame reveal-image">
      <iframe
        src={src}
        title={title ?? 'Video'}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .lb-video-frame {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }
  .lb-video-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
