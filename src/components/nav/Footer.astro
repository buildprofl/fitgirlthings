---
import { legalNav, site, nav } from '~/lib/site'
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="container footer-wrap">
    <div class="footer-brand">
      <strong>{site.name}</strong>
      <p>Editorial wellness, event culture, and the fit-girl world under one roof.</p>
      <a class="footer-social" href={site.instagram} target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h.01"/>
        </svg>
        {site.handle}
      </a>
    </div>

    <div class="footer-col">
      <span class="col-title">Read</span>
      {nav.slice(0, 5).map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/#partners">Work with us</a>
    </div>

    <div class="footer-col">
      <span class="col-title">Legal</span>
      {legalNav.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>

    <div class="footer-col">
      <span class="col-title">Reach out</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href="/#newsletter">Join the newsletter</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <small>© {year} {site.name}. All rights reserved.</small>
    <small>Made with intention in Miami.</small>
  </div>
</footer>

<style>
  .footer {
    padding: 4rem 0 2rem;
    background: linear-gradient(180deg, transparent, var(--surface-soft));
    margin-top: 3rem;
  }

  .footer-wrap {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .footer-brand strong {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .footer-brand p {
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 1rem;
    max-width: 32ch;
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-deep);
    font-weight: 700;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .col-title {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .footer-col a {
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease-out);
    font-size: 0.95rem;
  }

  .footer-col a:hover { color: var(--accent-deep); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    color: var(--muted);
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 820px) {
    .footer-wrap {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 480px) {
    .footer-wrap { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
