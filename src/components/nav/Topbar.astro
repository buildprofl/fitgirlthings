---
import { nav, site } from '~/lib/site'

const currentPath = Astro.url.pathname
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })
---

<div class="masthead-bar">
  <div class="container masthead-inner">
    <span class="masthead-date">{today}</span>
    <a href={site.instagram} target="_blank" rel="noreferrer" class="masthead-social">{site.handle}</a>
  </div>
</div>

<header class="topbar">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-mark" aria-hidden="true">FGT</span>
      <span class="brand-text">
        <strong>{site.name}</strong>
        <small>{site.tagline}</small>
      </span>
    </a>

    <button
      class="mobile-toggle"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav" data-menu>
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: currentPath === item.href }]}
        >
          {item.label}
        </a>
      ))}
      <a class="nav-cta" href="/#newsletter">Join the list</a>
      <button
        type="button"
        class="theme-toggle"
        aria-label="Toggle color theme"
        data-theme-toggle
        title="Toggle theme"
      >
        <svg class="theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg class="theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .masthead-bar {
    background: var(--text);
    color: color-mix(in oklab, var(--bg) 88%, transparent);
  }

  .masthead-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .masthead-date {
    opacity: 0.75;
  }

  .masthead-social {
    color: inherit;
    font-weight: 600;
    opacity: 0.9;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .masthead-social:hover { opacity: 1; }

  @media (max-width: 640px) {
    .masthead-date { display: none; }
    .masthead-inner { justify-content: flex-end; }
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-height);
    gap: 1.2rem;
    position: relative;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .brand:hover { opacity: 0.85; }

  .brand-mark {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #ffd0d8, #f5a6ba);
    color: #5f2942;
    font-weight: 800;
    box-shadow: var(--shadow-soft);
    letter-spacing: 0.02em;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    color: var(--text);
  }

  .brand-text strong { font-size: 1rem; }
  .brand-text small { color: var(--muted); font-size: 0.8rem; }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.35rem;
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--text);
    padding: 0.5rem 0;
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    background: var(--accent-strong);
    transition: width var(--dur-med) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-deep);
  }

  .nav-link.active::after,
  .nav-link:hover::after {
    width: 100%;
  }

  .nav-cta {
    background: var(--accent-strong);
    color: #fff;
    border-radius: 999px;
    padding: 0.75rem 1.15rem;
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.01em;
    box-shadow: 0 4px 16px var(--accent-glow);
    transition: transform var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .nav-cta:hover {
    transform: translateY(-1px);
    background: var(--accent-deep);
    box-shadow: 0 8px 22px var(--accent-glow);
  }

  .theme-toggle {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    color: var(--text);
    transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    background: var(--surface);
    transform: translateY(-1px);
  }

  .theme-sun, .theme-moon { position: absolute; transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-med) var(--ease-out); }
  :root:not([data-theme='dark']) .theme-moon { opacity: 0; transform: rotate(-40deg); }
  :root:not([data-theme='dark']) .theme-sun  { opacity: 1; transform: rotate(0); }
  :root[data-theme='dark'] .theme-moon { opacity: 1; transform: rotate(0); }
  :root[data-theme='dark'] .theme-sun  { opacity: 0; transform: rotate(40deg); }

  .mobile-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    border: 1px solid var(--line);
    padding: 0.7rem;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-toggle span {
    display: block;
    height: 2px;
    width: 20px;
    background: var(--text);
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
    border-radius: 2px;
  }

  .mobile-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .mobile-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .mobile-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 820px) {
    .mobile-toggle { display: inline-flex; }

    .nav {
      position: absolute;
      top: calc(100% + 0.8rem);
      right: 1rem;
      left: 1rem;
      background: color-mix(in oklab, var(--surface) 96%, transparent);
      border: 1px solid var(--line);
      border-radius: 20px;
      box-shadow: var(--shadow);
      display: none;
      flex-direction: column;
      align-items: stretch;
      padding: 1rem;
      gap: 0.35rem;
      z-index: var(--z-menu);
    }

    .nav-link {
      padding: 0.85rem 1rem;
      border-radius: 12px;
    }

    .nav-link:hover,
    .nav-link.active {
      background: color-mix(in oklab, var(--accent-strong) 12%, transparent);
    }

    .nav-link::after { display: none; }

    .nav-cta {
      text-align: center;
      justify-content: center;
      display: inline-flex;
      margin-top: 0.35rem;
    }

    .theme-toggle {
      align-self: flex-end;
      margin-top: 0.4rem;
    }

    .nav.open { display: flex; }
  }

  @media (max-width: 640px) {
    .nav-wrap { min-height: 72px; }
    .brand { gap: 0.6rem; }
    .brand-mark { width: 40px; height: 40px; font-size: 0.9rem; }
    .brand-text small { display: none; }
  }
</style>

<script>
  // Dark mode + mobile menu — small inline island (no framework)
  const root = document.documentElement
  const storageKey = 'fgt-theme'

  function applyTheme(theme: string | null) {
    if (theme === 'dark' || theme === 'light') {
      root.setAttribute('data-theme', theme)
    } else {
      root.removeAttribute('data-theme')
    }
  }

  // Initial (theme is already set inline in <head> before paint to avoid flash)
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  toggle?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme')
    const next = current === 'dark' ? 'light' : 'dark'
    applyTheme(next)
    try { localStorage.setItem(storageKey, next) } catch {}
  })

  // Mobile menu
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const menu = document.querySelector<HTMLElement>('[data-menu]')
  menuBtn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open')
    menuBtn.setAttribute('aria-expanded', String(!!open))
  })

  // Close menu on link click
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.remove('open')
      menuBtn?.setAttribute('aria-expanded', 'false')
    })
  })
</script>
