---
import { categories } from '~/lib/site'
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow">Explore now — get inspired today</span>
      <h1>Miami's fit-girl world, curated daily.</h1>
      <p class="hero-lead">
        Studio openings, industry news, wellness trends, product finds, and the trainers
        shaping the city's fitness culture — all in one place, updated as it happens.
      </p>

      <div class="hero-actions">
        <a href="/#newsletter" class="button primary">Join the Insider list</a>
        <a href="/spotted" class="button secondary">See what's Spotted</a>
      </div>

      <div class="hero-categories">
        {categories.map((cat) => (
          <a href={`/${cat.slug}`} class="hero-cat-pill">{cat.label}</a>
        ))}
      </div>
    </div>

    <div class="hero-visual reveal">
      <img
        src="/uploads/migrated/logo.webp"
        alt="Fit Girl Things"
        class="hero-logo"
        loading="eager"
        decoding="async"
        width="649"
        height="324"
      />
      <div class="hero-note">
        <span class="eyebrow">Here's the tea</span>
        <p>What's worth it. What's not. What's actually opening, closing, and changing across Miami's fitness scene.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 4rem);
    position: relative;
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: auto;
    border-radius: 999px;
    filter: blur(70px);
    z-index: -1;
    pointer-events: none;
  }

  .hero::before {
    width: 340px;
    height: 340px;
    background: var(--accent-glow);
    right: 2%;
    top: 5%;
  }

  .hero::after {
    width: 260px;
    height: 260px;
    background: color-mix(in oklab, #ffd5bf 60%, transparent);
    left: 5%;
    bottom: 8%;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2.6rem;
    align-items: center;
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-display);
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 12ch;
    margin: 0.55rem 0 1rem;
    font-weight: 600;
  }

  .hero-lead {
    max-width: 58ch;
    margin-bottom: 1.6rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .hero-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .hero-cat-pill {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--surface) 70%, transparent);
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    transition: background var(--dur-fast), border-color var(--dur-fast), transform var(--dur-fast);
  }
  .hero-cat-pill:hover {
    border-color: var(--accent-strong);
    background: var(--surface);
    transform: translateY(-1px);
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  .hero-logo {
    width: 100%;
    max-width: 420px;
    height: auto;
    filter: drop-shadow(0 20px 45px rgba(115, 61, 79, 0.12));
  }

  .hero-note {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface), var(--surface-soft));
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--line);
    text-align: center;
    max-width: 420px;
  }

  .hero-note p {
    margin: 0.65rem 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
  }

  @media (max-width: 820px) {
    .hero { padding-top: 2rem; }
    .hero h1 { font-size: clamp(2.4rem, 12vw, 4.6rem); }
    .hero-actions { flex-direction: column; }
    .hero-actions .button { width: 100%; }
  }
</style>
