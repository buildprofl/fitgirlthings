---
import heroData from '~/data/hero.json'
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow">The fit-girl world, edited well</span>
      <h1>{heroData.headline}</h1>
      <p class="hero-lead">{heroData.leadText}</p>

      <div class="hero-actions">
        <a href="/#newsletter" class="button primary">Join the newsletter</a>
        <a href="/feed" class="button secondary">Read the feed</a>
      </div>

      <div class="hero-proof">
        <div>
          <strong>1K+</strong>
          <span>wellness-forward women reached</span>
        </div>
        <div>
          <strong>Sold out</strong>
          <span>event energy built for demand</span>
        </div>
        <div>
          <strong>Digital + IRL</strong>
          <span>media brand meets community</span>
        </div>
      </div>
    </div>

    <div class="hero-visual reveal">
      <div class="hero-card main reveal-image">
        <img
          src={heroData.mainImage}
          srcset={`${heroData.mainImageMobile} 375w, ${heroData.mainImage} 800w`}
          sizes="(max-width: 820px) 100vw, 50vw"
          alt={heroData.mainImageAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width="800"
          height="994"
        />
        <div class="overlay-badge">{heroData.mainImageBadge}</div>
      </div>
      <div class="hero-stack">
        <div class="hero-card small reveal-image">
          <img
            src={heroData.secondaryImage}
            srcset={`${heroData.secondaryImageMobile} 300w, ${heroData.secondaryImage} 500w`}
            sizes="(max-width: 820px) 100vw, 35vw"
            alt={heroData.secondaryImageAlt}
            loading="lazy"
            decoding="async"
            width="500"
            height="525"
          />
        </div>
        <div class="hero-note">
          <span class="eyebrow">Here's the tea</span>
          <p>What is worth it. What is not. What the fit girls are actually doing.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2rem, 4vw, 4rem);
    position: relative;
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: auto;
    border-radius: 999px;
    filter: blur(70px);
    z-index: -1;
    pointer-events: none;
  }

  .hero::before {
    width: 340px;
    height: 340px;
    background: var(--accent-glow);
    right: 2%;
    top: 5%;
  }

  .hero::after {
    width: 260px;
    height: 260px;
    background: color-mix(in oklab, #ffd5bf 60%, transparent);
    left: 5%;
    bottom: 8%;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2.6rem;
    align-items: center;
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: var(--fs-display);
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 12ch;
    margin: 0.55rem 0 1rem;
    font-weight: 600;
  }

  .hero-lead {
    max-width: 58ch;
    margin-bottom: 1.6rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .hero-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .hero-proof div {
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--surface) 82%, transparent);
    box-shadow: var(--shadow-soft);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .hero-proof div:hover { transform: translateY(-2px); }

  .hero-proof strong {
    display: block;
    font-size: 1.1rem;
    margin-bottom: 0.35rem;
    font-family: var(--font-serif);
    letter-spacing: -0.01em;
  }

  .hero-proof span {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .hero-visual {
    display: grid;
    grid-template-columns: 1.2fr 0.82fr;
    gap: 1rem;
    align-items: stretch;
  }

  .hero-card {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
    position: relative;
    background: var(--surface);
    transition: transform var(--dur-med) var(--ease-out);
  }

  .hero-card:hover { transform: translateY(-3px); }

  .hero-card.main img {
    aspect-ratio: 0.9 / 1.12;
    object-fit: cover;
    width: 100%;
  }

  .hero-card.small img {
    aspect-ratio: 0.95 / 1;
    object-fit: cover;
    width: 100%;
  }

  .overlay-badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.65rem 0.9rem;
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    color: var(--text);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .hero-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-note {
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface), var(--surface-soft));
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--line);
  }

  .hero-note p {
    margin: 0.65rem 0 0;
    color: var(--muted);
    line-height: var(--leading-normal);
  }

  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
  }

  @media (max-width: 820px) {
    .hero { padding-top: 2rem; }
    .hero h1 { font-size: clamp(2.4rem, 12vw, 4.6rem); }
    .hero-proof { grid-template-columns: 1fr; gap: 0.8rem; }
    .hero-visual { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; }
    .hero-actions .button { width: 100%; }
  }
</style>
