---
import SectionHeader from '~/components/ui/SectionHeader.astro'
import { getCollection } from 'astro:content'

const all = await getCollection('articles', ({ data }) => !data.draft)
const sorted = all.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
)
const lead = sorted[0]
const rest = sorted.slice(1, 7)
---

<section id="feed" class="feed section">
  <div class="container">
    <SectionHeader
      eyebrow="The Feed"
      title="Editorial magazine energy, structured for growth."
      text="Stories, categories, and repeatable formats that scale into a true publication."
    />

    <div class="feed-layout">
      {lead && (
        <a href={`/feed/${lead.slug}`} class="lead-story reveal">
          <div class="lead-image reveal-image">
            <img
              src={lead.data.image}
              srcset={`${lead.data.imageMobile ?? lead.data.image} 375w, ${lead.data.image} 900w`}
              sizes="(max-width: 820px) 100vw, 60vw"
              alt={lead.data.imageAlt ?? lead.data.title}
              loading="lazy"
              decoding="async"
              width="900"
              height="600"
            />
          </div>
          <div class="lead-copy">
            <span class="mini-kicker">{lead.data.kicker ?? 'Lead Story'}</span>
            <h3>{lead.data.title}</h3>
            <p>{lead.data.excerpt}</p>
            <span class="text-link">Read the story</span>
          </div>
        </a>
      )}

      <div class="feed-grid">
        {rest.map((item, i) => (
          <a href={`/feed/${item.slug}`} class="feed-card reveal" style={`transition-delay: ${i * 60}ms`}>
            <div class="feed-image reveal-image">
              <img
                src={item.data.image}
                srcset={`${item.data.imageMobile ?? item.data.image} 320w, ${item.data.image} 700w`}
                sizes="(max-width: 820px) 100vw, (max-width: 1080px) 50vw, 33vw"
                alt={item.data.imageAlt ?? item.data.title}
                loading="lazy"
                decoding="async"
                width="700"
                height="630"
              />
            </div>
            <div class="feed-copy">
              <span class="mini-kicker">{item.data.category}</span>
              <h3>{item.data.title}</h3>
              <p>{item.data.excerpt}</p>
              <span class="text-link">Open story</span>
            </div>
          </a>
        ))}
      </div>

      <div class="feed-more">
        <a href="/feed" class="button secondary">See all stories</a>
      </div>
    </div>
  </div>
</section>

<style>
  .feed-layout { display: grid; gap: 1.4rem; }

  .lead-story {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 1.25rem;
    padding: 1rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--surface), var(--surface-soft));
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
    transition: transform var(--dur-med) var(--ease-out), box-shadow var(--dur-med) var(--ease-out);
    color: inherit;
  }

  .lead-story:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .lead-image {
    overflow: hidden;
    border-radius: calc(var(--radius-xl) - 8px);
  }

  .lead-image img {
    width: 100%;
    height: 100%;
    min-height: 380px;
    object-fit: cover;
    display: block;
    transition: transform 600ms var(--ease-out);
  }

  .lead-story:hover .lead-image img { transform: scale(1.03); }

  .lead-copy {
    padding: 1rem 0.35rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lead-copy h3 {
    margin: 0.7rem 0 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .lead-copy p {
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .feed-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .feed-card {
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform var(--dur-med) var(--ease-out), box-shadow var(--dur-med) var(--ease-out);
  }

  .feed-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .feed-image { overflow: hidden; }

  .feed-image img {
    width: 100%;
    aspect-ratio: 1 / 0.9;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .feed-card:hover .feed-image img { transform: scale(1.05); }

  .feed-copy {
    padding: 1.15rem 1.15rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .feed-copy h3 {
    margin: 0.5rem 0 0.35rem;
    font-size: 1.15rem;
    line-height: 1.3;
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .feed-copy p {
    margin: 0 0 auto;
    color: var(--muted);
    line-height: var(--leading-relaxed);
    font-size: 0.95rem;
  }

  .feed-more {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  @media (max-width: 1080px) {
    .lead-story { grid-template-columns: 1fr; }
    .lead-image img { min-height: 260px; }
    .feed-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .feed-grid { grid-template-columns: 1fr; }
  }
</style>
