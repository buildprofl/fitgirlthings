---
import SectionHeader from '~/components/ui/SectionHeader.astro'
import NewsletterForm from '~/components/react/NewsletterForm.jsx'
import { site } from '~/lib/site'
---

<section id="contact" class="contact section">
  <div class="container contact-grid">
    <div>
      <SectionHeader
        eyebrow="Contact"
        title="Let's grow the list, fill the room, and build the right brand collaborations."
        text="Use this section for readers, event RSVPs, corporate wellness inquiries, sponsor asks, or media introductions."
      />
      <div class="contact-links reveal">
        <a href={`mailto:${site.email}`} class="contact-line">
          <span class="dot" aria-hidden="true"></span>
          {site.email}
        </a>
        <a href={site.instagram} target="_blank" rel="noreferrer" class="contact-line">
          <span class="dot" aria-hidden="true"></span>
          {site.handle}
        </a>
        <a href="/contact" class="contact-line">
          <span class="dot" aria-hidden="true"></span>
          Full contact page →
        </a>
      </div>
    </div>

    <aside class="contact-card reveal">
      <h3>Quick inquiry</h3>
      <p>
        For launch speed, route interest through one inbox. Segment later by event, sponsor,
        press, and newsletter.
      </p>
      <NewsletterForm client:load compact source="home-contact" />
    </aside>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: start;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .contact-line {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--accent-deep);
    font-weight: 700;
    padding: 0.65rem 0.9rem;
    border-radius: 12px;
    background: color-mix(in oklab, var(--surface) 60%, transparent);
    border: 1px solid var(--line);
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
    width: fit-content;
    max-width: 100%;
  }

  .contact-line:hover {
    transform: translateX(4px);
    background: var(--surface);
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--accent-strong);
    border-radius: 999px;
  }

  .contact-card {
    padding: 1.85rem;
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--surface) 90%, transparent);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .contact-card h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    letter-spacing: -0.01em;
  }

  .contact-card p {
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
