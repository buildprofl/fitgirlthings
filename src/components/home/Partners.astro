---
import SectionHeader from '~/components/ui/SectionHeader.astro'

const points = [
  'Studios and brands: get featured — reach out and tell us what makes you worth spotting',
  'Have news worth sharing? Send it our way and we’ll take a look',
  'Want to host an event under the Fit Girl Things name? Let’s talk',
  'Product to get in front of Miami’s fitness crowd? We want to see it',
]
---

<section id="partners" class="partners section soft">
  <div class="container partners-grid">
    <div>
      <SectionHeader
        eyebrow="Work with us"
        title="Get featured, share news, or bring us your event."
        text="Fit Girl Things covers the studios, brands, and people shaping Miami's fitness scene — here's how to get on our radar."
      />
      <ul class="partner-list reveal">
        {points.map((p) => (
          <li>
            <span class="check" aria-hidden="true">✓</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>

    <aside class="partner-panel reveal">
      <span class="mini-kicker">Get in touch</span>
      <h3>Studios, brands, trainers, and event hosts</h3>
      <p>
        Whether you're opening a studio, launching a product, or planning an event you'd like
        to bring under the Fit Girl Things name — reach out and tell us more.
      </p>
      <a href="/contact" class="button primary full">Reach out</a>
      <a href="/faqs" class="text-link" style="margin-top:1rem;display:inline-flex">Read our FAQs</a>
    </aside>
  </div>
</section>

<style>
  .partners-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2rem;
    align-items: start;
  }

  .partner-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }

  .partner-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: var(--text);
    line-height: var(--leading-relaxed);
  }

  .check {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--accent-strong);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .partner-panel {
    padding: 1.85rem;
    border-radius: var(--radius-xl);
    background: color-mix(in oklab, var(--surface) 90%, transparent);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .partner-panel h3 {
    margin: 0.7rem 0 0.9rem;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .partner-panel p {
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 1.4rem;
  }

  @media (max-width: 900px) {
    .partners-grid { grid-template-columns: 1fr; }
  }
</style>
